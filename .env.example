LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
TRIAGE_MODEL=gpt-4o-mini
DEEP_MODEL=gpt-4o
# price per 1M tokens (input,output)
TRIAGE_PRICE=0.15,0.6
DEEP_PRICE=2.5,10
FIT_THRESHOLD=60
# USD to Iranian rial fallback and exchange-rate cache time (6 hours)
USD_TO_RIAL_FALLBACK=600000
EXCHANGE_RATE_REFRESH_SECONDS=21600
# Change these values in production. Defaults are admin / 12345 for local setup only.
ADMIN_USERNAME=admin
# Secret header required by Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=change-this-secret
ADMIN_PASSWORD=12345
